# ---------------------------------------------------------------------------
# HomeLedger configuration
# 复制为 .env 后按需修改。所有变量都以 HOMELEDGER_ 开头。
# ---------------------------------------------------------------------------

# 部署模式：local（单机） | gateway（家庭网关，推荐） | cloud（云服务器）
HOMELEDGER_DEPLOYMENT_MODE=gateway

# 对外端口
HOMELEDGER_PORT=8000

# 【必须修改】会话签名密钥。生成方式：openssl rand -base64 48
# 更换后所有已登录设备都需要重新登录。
HOMELEDGER_SECRET_KEY=please-change-this-to-a-long-random-string

# 数据卷名称（默认 hl-data）或宿主机绝对路径，例如 /volume1/docker/homeledger
HOMELEDGER_DATA_VOLUME=hl-data
# 仅在使用宿主机目录且 SELinux 开启时需要 :Z（CentOS 7 / RHEL）
# HOMELEDGER_DATA_VOLUME_OPTS=:Z

# 是否允许自助注册。首次启动的第一个账号始终可以注册。
# 家庭成员都注册完成后建议改为 false，由管理员在「成员」页面邀请。
HOMELEDGER_ALLOW_REGISTRATION=true

# 仅账号服务使用：开启后注册只写用户行，不创建家庭/物品数据。
# 自建数据服务器（用户自己的网关）不要开启。
# HOMELEDGER_SERVICE_MODE=true
# 注册邮箱白名单，逗号分隔。SERVICE_MODE 开启且留空时默认只允许 qq.com；
# 自建服务器留空表示不限制（family@example.com、home.lan 都可以）。
# HOMELEDGER_EMAIL_DOMAINS=qq.com

# 单个附件大小上限（MB）
HOMELEDGER_MAX_UPLOAD_MB=64

# 允许的跨域来源，逗号分隔；* 表示全部（同源部署时无需修改）
HOMELEDGER_CORS_ORIGINS=*

# 内存上限（Docker 资源限制），NAS 上建议 256M–512M
HOMELEDGER_MEMORY_LIMIT=512M

# ---------------------------------------------------------------------------
# 数据库
# 留空 = 使用 SQLite（/data/homeledger.db），适合 local / gateway。
# 云端可改为 PostgreSQL（需使用 --profile postgres 并安装 psycopg2）。
# ---------------------------------------------------------------------------
HOMELEDGER_DATABASE_URL=
# HOMELEDGER_DATABASE_URL=postgresql+psycopg2://homeledger:CHANGE_ME_POSTGRES_PASSWORD@postgres:5432/homeledger
# 使用 PostgreSQL 时改成你自己的强密码，并同步修改上面的连接串。
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD

# ---------------------------------------------------------------------------
# 附件存储：local（默认） | s3（需安装 boto3，兼容 MinIO / R2 / 阿里云 OSS）
# ---------------------------------------------------------------------------
HOMELEDGER_STORAGE_BACKEND=local
# HOMELEDGER_S3_ENDPOINT=https://minio.lan:9000
# HOMELEDGER_S3_BUCKET=homeledger
# HOMELEDGER_S3_ACCESS_KEY=
# HOMELEDGER_S3_SECRET_KEY=

# ---------------------------------------------------------------------------
# AI / OCR：local（不外发，仅提示） | cloud（OpenAI 兼容视觉接口） | disabled
# 选择 cloud 时，上传的图片会离开本设备，界面会明确提示。
# ---------------------------------------------------------------------------
HOMELEDGER_AI_PROVIDER=local
# HOMELEDGER_AI_ENDPOINT=https://api.openai.com/v1
# HOMELEDGER_AI_API_KEY=sk-...

# ---------------------------------------------------------------------------
# 通知：inapp（站内） | email | webhook，可组合，逗号分隔
# ---------------------------------------------------------------------------
HOMELEDGER_NOTIFICATION_CHANNELS=inapp
# HOMELEDGER_SMTP_HOST=smtp.example.com
# HOMELEDGER_SMTP_PORT=587
# HOMELEDGER_SMTP_USER=
# HOMELEDGER_SMTP_PASSWORD=
# HOMELEDGER_SMTP_FROM=HomeLedger <noreply@example.com>
# HOMELEDGER_WEBHOOK_URL=https://ntfy.sh/your-topic

# 自动备份间隔（小时），0 表示关闭
HOMELEDGER_AUTO_BACKUP_HOURS=24

# 容器时区：只影响日志与脚本时间戳。数据一律按 UTC 存储，界面按设备本地时区显示。
TZ=Asia/Shanghai
