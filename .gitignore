# build output copied into the backend for single-binary serving
# (sw.js is generated from frontend/public/sw.js; the whole folder is disposable)
backend/app/static/

# desktop build artifacts
src-tauri/target/
# gen/schemas is regenerated from capabilities on every build; gen/android is
# the actual Android Studio project and must be committed — regenerating it
# silently throws away the manifest and Gradle tweaks below.
src-tauri/gen/schemas/
src-tauri/gen/android/app/build/
src-tauri/gen/android/build/
src-tauri/gen/android/.gradle/
src-tauri/gen/android/local.properties
src-tauri/gen/android/app/src/main/jniLibs/
# the frozen sidecar is ~90MB and rebuilt by scripts/build-desktop.sh
src-tauri/server/homeledger-server/
backend/build/
backend/dist/

# env & secrets
.env
.env.*
!.env.example
.secret_key
.install_id
.signing/
*.pfx
*.p12
*.jks
*.keystore
**/password.txt
.local-snapshots/
.tmp-*/
*.log

# os / editor
.DS_Store
.idea/
.vscode/
*.swp

